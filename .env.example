# Your TypeSafe API key. Without it the router falls back to the rules decider.
TYPESAFE_API_KEY=

# The key your OpenAI-compatible proxy expects. Only evals/run_outcomes.py uses it;
# the router itself forwards the client's own Authorization header.
UPSTREAM_API_KEY=

# The proxy to forward to. Overrides settings.upstream_base_url in router.yaml.
JEV_ROUTER_UPSTREAM=http://127.0.0.1:8317
