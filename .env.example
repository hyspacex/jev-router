# Your TypeSafe API key. Without it the router falls back to the rules decider.
TYPESAFE_API_KEY=

# The key your OpenAI-compatible proxy expects. Only evals/run_outcomes.py and
# evals/qualify_effort.py use it; the router itself forwards the client's own
# Authorization header.
UPSTREAM_API_KEY=

# The proxy to forward to. Overrides settings.upstream_base_url in router.yaml.
JEV_ROUTER_UPSTREAM=http://127.0.0.1:8317

# Separate token for /router/* endpoints (X-Router-Admin-Token).
# Without it, only direct loopback callers may access router-owned endpoints.
# Strict sessions require it on every request, loopback included, and there is
# no setting that turns that off.
JEV_ROUTER_ADMIN_TOKEN=

# Optional. The default for -c/--config on every subcommand. Set it when the
# config lives outside the checkout, as it does in a deployment.
# JEV_ROUTER_CONFIG=~/.config/jev-router.yaml

# Optional, evals only.
# JEV_EVAL_JUDGE_MODEL=gpt-5.6-sol(high)   # the outcome benchmark's judge
# JEV_ROUTER_QUALIFY_LIVE=1                # with --confirm-live, lets
#                                          # evals/qualify_effort.py call a
#                                          # real provider
# JEV_ROUTER_QUALIFY_ALLOW=                # extra profiles it may qualify
